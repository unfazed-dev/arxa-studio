    "@codingame/monaco-vscode-dart-default-extension": "36.2.7",
    "@codingame/monaco-vscode-editor-api": "36.2.7",
    "@codingame/monaco-vscode-extensions-service-override": "36.2.7",
    "@codingame/monaco-vscode-files-service-override": "36.2.7",
    "@codingame/monaco-vscode-html-default-extension": "36.2.7",
    "@codingame/monaco-vscode-javascript-default-extension": "36.2.7",
    "@codingame/monaco-vscode-json-default-extension": "36.2.7",
    "@codingame/monaco-vscode-keybindings-service-override": "36.2.7",
    "@codingame/monaco-vscode-languages-service-override": "36.2.7",
    "@codingame/monaco-vscode-less-default-extension": "^36.2.7",
    "@codingame/monaco-vscode-markdown-basics-default-extension": "^36.2.7",
    "@codingame/monaco-vscode-model-service-override": "36.2.7",
