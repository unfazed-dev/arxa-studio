{
  "name": "arxa-artifact-viewer-monaco-build",
  "private": true,
  "type": "module",
  "description": "Isolated dev-time sources for the Monaco/VS Code viewer bundle (G7-G12). npm install HERE — root npm operations never see this dir (same reason as vendor-build). Output goes to dist/ and is NOT committed: pack-sidecar builds it into the engine payload (G12); the lockfile IS committed so the build is reproducible.",
  "scripts": {
    "build": "vite build"
  },
