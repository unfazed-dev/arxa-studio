# Ubuntu 22.04 build image for the Linux RELEASE artifacts (AppImage, deb).
#
# Why a second image beside Dockerfile.arch: Tauri's guidance is to build
# AppImages on the oldest base you intend to support, because the build host's
# glibc becomes the floor for every user (22.04 = glibc 2.35, so the result runs
# on Ubuntu 22.04+, Debian 12+, Fedora 36+, Arch); and on Arch, linuxdeploy's
# gtk plugin dies on a gdk-pixbuf loaders dir that distro no longer has.
# The Arch image stays the dev loop and the PKGBUILD lane.
#
#   docker build -f scripts/linux/Dockerfile.ubuntu -t arxa-ubuntu:arm64 scripts/linux
#   DISTRO=ubuntu scripts/linux/run-container.sh appimage
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive

# Tauri's own 22.04 prerequisite list, plus what linuxdeploy-plugin-gtk shells
# out to (gtk-query-immodules, gdk-pixbuf-query-loaders, glib-compile-schemas,
# desktop-file-validate) and what the bring-up needs at runtime (bwrap,
# secret-tool + a keyring, zenity, Xvfb, a session bus).
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential curl ca-certificates git rsync pkg-config file patchelf \
      libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev \
      librsvg2-dev libssl-dev libxdo-dev \
      libgtk-3-bin libgdk-pixbuf2.0-bin libglib2.0-bin desktop-file-utils \
      bubblewrap libsecret-tools gnome-keyring dbus dbus-x11 \
      xdg-desktop-portal xdg-desktop-portal-gtk \
      xvfb fonts-dejavu-core zenity \
      unzip zip jq procps python3 strace xz-utils \
  && rm -rf /var/lib/apt/lists/*

# Node from the official tarball (22.04's own node is 12). Pinned to what the
# Arch image and the host run; the packed sidecar embeds THIS node.
ARG NODE_VERSION=26.8.1
RUN set -eu; \
    case "$(uname -m)" in aarch64) A=arm64 ;; x86_64) A=x64 ;; *) echo "unsupported arch" >&2; exit 1 ;; esac; \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${A}.tar.xz" | tar -xJ -C /opt; \
    ln -s "/opt/node-v${NODE_VERSION}-linux-${A}" /opt/node; \
    /opt/node/bin/node -v
ENV PATH="/opt/node/bin:${PATH}"

# Rust via rustup (22.04's rust is 1.58). Toolchain and the proxies live under
# /opt so the per-run CARGO_HOME volume mounted at ~/.cargo does not hide them.
ENV RUSTUP_HOME=/opt/rustup
RUN curl -fsSL https://sh.rustup.rs | CARGO_HOME=/opt/cargo sh -s -- -y --no-modify-path --profile minimal \
 && chmod -R a+rX /opt/rustup /opt/cargo && /opt/cargo/bin/cargo --version
ENV PATH="/opt/cargo/bin:${PATH}"

# Same Dart SDK as Dockerfile.arch (arxa/arxa/pubspec.yaml `sdk: ^3.12.0`).
ARG DART_VERSION=3.13.2
RUN set -eu; \
    case "$(uname -m)" in aarch64) DART_ARCH=arm64 ;; x86_64) DART_ARCH=x64 ;; esac; \
    curl -fsSL "https://storage.googleapis.com/dart-archive/channels/stable/release/${DART_VERSION}/sdk/dartsdk-linux-${DART_ARCH}-release.zip" -o /tmp/dart.zip; \
    unzip -q /tmp/dart.zip -d /opt; rm /tmp/dart.zip; /opt/dart-sdk/bin/dart --version
ENV PATH="/opt/dart-sdk/bin:${PATH}"
ENV PUB_CACHE=/home/builder/.pub-cache

# bun compiles the packed sidecar (scripts/pack-sidecar.mjs); pnpm materialises
# the profile. Same pins as Dockerfile.arch.
ARG BUN_VERSION=1.4.2
ARG PNPM_VERSION=11.21.0
RUN npm install -g --allow-scripts=bun "bun@${BUN_VERSION}" "pnpm@${PNPM_VERSION}" && bun --version && pnpm --version

RUN useradd -m -u 1000 builder && chown -R builder:builder /home/builder
USER builder
WORKDIR /work/arxa-studio
RUN mkdir -p /home/builder/.local/share /home/builder/.cache /home/builder/.config \
      /home/builder/.npm /home/builder/.cargo
RUN git config --global --add safe.directory '*' \
 && git config --global user.email "bringup@arxa.local" \
 && git config --global user.name "arxa bringup" \
 && git config --global init.defaultBranch main
ENV CARGO_HOME=/home/builder/.cargo \
    npm_config_cache=/home/builder/.npm
CMD ["/bin/bash"]
